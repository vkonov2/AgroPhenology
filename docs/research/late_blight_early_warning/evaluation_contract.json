  "timeliness_window_days": {"minimum": 3, "maximum": 10},
  "daily_target": {
    "imminent": [0, 2],
    "actionable": [3, 10],
    "no_record_in_horizon": "no first registry record through issue_date_plus_10 within observed registry follow-up",
    "unknown": "mask_not_a_negative_class"
  },
  "entry": "day_after_first_eligible_registry_visit",
