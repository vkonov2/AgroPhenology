  },
  "rolling_origin_folds": [
    {"id": "test_2020", "train_years": [2010, 2017], "validation_years": [2018, 2019], "test_years": [2020, 2020]},
    {"id": "test_2021", "train_years": [2010, 2018], "validation_years": [2019, 2020], "test_years": [2021, 2021]},
