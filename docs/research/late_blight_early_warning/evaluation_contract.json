    "C2": "catboost_calendar_plus_nasa_common_daily_aggregates",
    "C3": "catboost_calendar_plus_era5_common_daily_aggregates",
    "C4": "catboost_calendar_plus_reconstructable_era5_daily_episodes",
    "C5": "multinomial_logistic_same_C4_features",
